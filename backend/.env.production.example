# Variables de producción. Copia este archivo como backend/.env.production (no se sube a git)
# y completa los valores marcados. Ver docs/despliegue.md.
APP_NAME="APP FET"
APP_ENV=production
# Genera la llave con: docker compose exec api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://practicas.fet.edu.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

FET_DOMINIO_CORREO=fet.edu.co
FRONTEND_URL=https://practicas.fet.edu.co
FET_VERSION_POLITICA=2026-1
GITHUB_TOKEN=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=app_fet
DB_USERNAME=app_fet
# Usa una clave larga y aleatoria
DB_PASSWORD=

SESSION_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Servidor de correo real (por ejemplo, la cuenta institucional de la FET)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="practicas@fet.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

# Días que se conservan los respaldos diarios
RETENCION_DIAS=14
